<Window x:Class="StokYonetimSistemi.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş Yap" Height="450" Width="800">


    <Grid>
        <!-- Arka Plan Resmi -->
        <Image Source="stokk.jpg" Stretch="Fill" Panel.ZIndex="0"/>

        

        <!-- Ortalanmış Beyaz Panel -->
        <Border Width="350" Padding="30" Background="White" CornerRadius="10" 
                VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#ccc" BorderThickness="1" Panel.ZIndex="1">
            <StackPanel>
                <!-- Başlık -->
                <TextBlock Text="Stok Yönetim Sistemine Giriş" 
                           FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Kullanıcı Adı -->
                <TextBlock Text="Kullanıcı Adı:" FontWeight="SemiBold" Margin="0,5"/>
                <TextBox x:Name="txtKullaniciAdi" Height="30" FontSize="14" Padding="5"/>

                <!-- Şifre -->
                <TextBlock Text="Şifre:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtSifre" Height="30" FontSize="14" Padding="5"/>

                <!-- Giriş Yap Butonu -->
                <Button Content="Giriş Yap" 
                        Height="35" 
                        Margin="0,20,0,0"
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Click="BtnGiris_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
