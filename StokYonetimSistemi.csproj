  <ItemGroup>
    <Compile Remove="AnaPencere.xaml.cs" />
    <Compile Remove="Views\BildirimlerView.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Image1.png" />
    <None Remove="stokk.jpg" />
    <None Remove="Views\stokk.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="AnaPencere.xaml" />
    <Page Remove="Views\BildirimlerView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
