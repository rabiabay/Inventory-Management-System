<UserControl x:Class="StokYonetimSistemi.Views.SatisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">

    <Grid Background="#ECF0F1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <StackPanel Background="#2C3E50" Grid.Column="0">
            <TextBlock Text="🛍 Satış Paneli" 
                       FontSize="20" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,30"/>

            <Button Content="🛒 Ürün Satışı" Click="BtnUrunSatis_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="📦 Stokları Gör" Click="BtnStoklariGor_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="⚠️ Kritik Ürünler" Click="BtnKritikUrunler_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="❤️ Favori Ürünler" Click="BtnFavoriUrunler_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="📝 Sipariş Et" Click="BtnSiparisEt_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="📋 Siparişlerim" Click="BtnSiparislerim_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="🧾 Fatura Geçmişi" Click="BtnFaturaGecmisi_Click"
                    Margin="10,5" Height="40"
                    Background="#34495E" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>

            <Button Content="🚪 Çıkış Yap" Click="BtnCikis_Click"
                    Margin="10,30,10,10" Height="40"
                    Background="#E74C3C" Foreground="White" FontSize="14"
                    FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand"/>
        </StackPanel>

      
        <Border Grid.Column="1" Margin="20" CornerRadius="10" Background="White"
                BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <ContentControl x:Name="SatisContent"/>
        </Border>
    </Grid>
</UserControl>
