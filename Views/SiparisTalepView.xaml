<UserControl x:Class="StokYonetimSistemi.Views.SiparisTalepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid Margin="20">
        <DataGrid x:Name="dgSiparisler" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sipariş ID" Binding="{Binding Siparis.SiparisID}" Width="*" />
                <DataGridTextColumn Header="Ürün" Binding="{Binding Urun.UrunAdi}" Width="*" />
                <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="100" />
                <DataGridTextColumn Header="Tarih" Binding="{Binding Siparis.Tarih}" Width="*" />
                <DataGridTextColumn Header="Durum" Binding="{Binding Siparis.Durum}" Width="*" />
                <DataGridTemplateColumn Header="İşlem" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Siparişi Gönder"
                                    Background="Green" Foreground="White" Padding="5"
                                    Click="BtnSiparisiGonder_Click"
                                    Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
