<UserControl x:Class="StokYonetimSistemi.Views.RaporlarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <StackPanel Margin="20">
        <TextBlock Text="📊 Raporlar" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <WrapPanel Margin="0,0,0,10">
            <Button Content="Kritik Stoklu Ürünler" Width="200" Margin="5" Click="BtnKritik_Click"/>
            <Button Content="Stokta Olmayan Ürünler" Width="200" Margin="5" Click="BtnStokYok_Click"/>
            <Button Content="Top 5 Sipariş Edilen Ürünler" Width="250" Margin="5" Click="BtnTopSiparis_Click"/>
            <Button Content="Kategoriye Göre Ürün Sayısı" Width="250" Margin="5" Click="BtnKategori_Click"/>
            <Button Content="Tedarikçiye Göre Siparişler" Width="250" Margin="5" Click="BtnTedarikci_Click"/>
            <Button Content="Son 30 Günde Giren Ürünler" Width="250" Margin="5" Click="BtnSonGiris_Click"/>
            <Button Content="Sipariş Verilmeyen Ürünler" Width="250" Margin="5" Click="BtnSiparisYok_Click"/>
        </WrapPanel>

        <DataGrid x:Name="dgRapor" AutoGenerateColumns="True" Height="400"/>
    </StackPanel>
</UserControl>
