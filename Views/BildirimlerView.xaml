<UserControl x:Class="StokYonetimSistemi.Views.BildirimlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <DataGrid x:Name="dgBildirimler" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mesaj" Binding="{Binding Mesaj}" Width="*" />
                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="200" />
                <DataGridCheckBoxColumn Header="Okundu" Binding="{Binding OkunduMu}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
