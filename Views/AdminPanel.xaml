<Window x:Class="StokYonetimSistemi.Views.AdminPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Height="600" Width="1000" WindowStartupLocation="CenterScreen" Background="#ECF0F1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Menü -->
        <StackPanel Background="#2C3E50" Grid.Column="0">
            <TextBlock Text="🛠 Admin Panel" 
                       FontSize="20" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,30"/>

            <Button Content="👥 Kullanıcılar" 
                    Click="BtnKullanicilar_Click"
                    Margin="10,5"
                    Height="40"
                    Background="#34495E" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

            <Button Content="📊 Sistem Özeti" 
                    Click="BtnSistemOzeti_Click"
                    Margin="10,5"
                    Height="40"
                    Background="#34495E" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

            <Button Content="📄 Log Kayıtları" 
                    Click="BtnLogKayitlari_Click"
                    Margin="10,5"
                    Height="40"
                    Background="#34495E" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

            <Button Content="🚪 Çıkış Yap" 
                    Click="BtnCikis_Click"
                    Margin="10,30,10,10"
                    Height="40"
                    Background="#E74C3C" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- İçerik Alanı -->
        <Border Grid.Column="1" Margin="20" CornerRadius="10" Background="White" 
        BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" BlurRadius="6" Color="Gray" />
            </Border.Effect>
            <ContentControl x:Name="AnaPanelIcerik"/>
        </Border>

    </Grid>
</Window>
