<UserControl x:Class="StokYonetimSistemi.Views.DepoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             >

    <Grid Background="#ECF0F1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Menü -->
        <StackPanel Background="#2C3E50" Grid.Column="0">
            <TextBlock Text="🏬 Depo Paneli"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,30"/>

            <Button Content="📦 Stokları Görüntüle" Click="BtnStoklar_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="🔄 Stok Hareketleri" Click="BtnHareket_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="📁 Depo Ürünleri" Click="BtnDepoUrunleri_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="⚠️ Kritik Ürünler" Click="BtnKritik_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="➕ Ürün Girişi" Click="BtnUrunGirisi_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="➖ Ürün Çıkışı" Click="BtnUrunCikisi_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="📦 Sipariş Talepleri" Click="BtnSiparisTalepleri_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="🛒 Sipariş Ver (Tedarikçili)" Click="BtnSiparisVer_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="📄 Rapor Al" Click="BtnRaporlar_Click"
                    Margin="10,5" Height="40" Background="#34495E"
                    Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

            <Button Content="🚪 Çıkış Yap" Click="BtnCikis_Click"
                    Margin="10,30,10,10" Height="40"
                    Background="#E74C3C" Foreground="White"
                    FontWeight="Bold" BorderBrush="Transparent"/>
        </StackPanel>

        <!-- İçerik Alanı -->
        <Border Grid.Column="1" Margin="20" CornerRadius="10" Background="White"
                BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <ContentControl x:Name="DepoContent"/>
        </Border>
    </Grid>
</UserControl>
