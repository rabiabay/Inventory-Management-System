<UserControl x:Class="StokYonetimSistemi.Views.KullaniciSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="714" Width="951">

    <Grid Background="#f5f5f5" RenderTransformOrigin="0.5,0.5" Height="820" Width="1140">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.378"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="10" Background="White" Padding="20" Margin="-8,-6,202,112" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.322"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="Kullanıcı Yönetimi" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0 0 0 20"/>

                
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <TextBox x:Name="txtAd" Width="150" Margin="0 0 10 0" Text="Ad" GotFocus="TextBox_GotFocus"/>
                    <TextBox x:Name="txtSoyad" Width="150" Margin="0 0 10 0" Text="Soyad" GotFocus="TextBox_GotFocus"/>
                    <TextBox x:Name="txtKullaniciAdi" Width="150" Margin="0 0 10 0" Text="Kullanıcı Adı" GotFocus="TextBox_GotFocus"/>
                    <PasswordBox x:Name="txtSifre" Width="150" Margin="0 0 10 0"/>
                    <ComboBox x:Name="cbRol" Width="150" Margin="0 0 10 0" DisplayMemberPath="RolAdi" SelectedValuePath="RolID"/>
                </StackPanel>

               
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Content="Ekle" Width="80" Margin="0 0 10 0" Background="#007ACC" Foreground="White" Click="BtnEkle_Click"/>
                    <Button Content="Güncelle" Width="80" Margin="0 0 10 0" Background="#28A745" Foreground="White" Click="BtnGuncelle_Click"/>
                    <Button Content="Sil" Width="80" Background="#DC3545" Foreground="White" Click="BtnSil_Click"/>
                </StackPanel>

               
                <DataGrid x:Name="dgKullanicilar"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionChanged="dgKullanicilar_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ad" Binding="{Binding Ad}" Width="*"/>
                        <DataGridTextColumn Header="Soyad" Binding="{Binding Soyad}" Width="*"/>
                        <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KullaniciAdi}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol.RolAdi}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
